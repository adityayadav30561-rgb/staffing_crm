{
  "$description": "Nirman design tokens for the website and the Nirman CRM screens. Code source: nirman-site/src/app/globals.css. CRM sizes are px at the 1240 x 590 desktop frame.",
  "color": {
    "neutral": {
      "paper": "#f6f2ea",
      "paper-2": "#eee8dc",
      "paper-3": "#e4dccb",
      "surface": "#ffffff",
      "ink": "#16181b",
      "ink-2": "#474c52",
      "ink-3": "#80868c",
      "line": "#e3ddd1",
      "hairline": "rgba(22,24,27,0.08)",
      "ring": "rgba(22,24,27,0.10)"
    },
    "crm": {
      "forest": "#123b32",
      "forest-2": "#1e5a4b",
      "forest-deep": "#0b2620",
      "mint": "#9fdcb8",
      "mint-soft": "#e0f1e6",
      "sage-2": "#b8dcc6",
      "sage-3": "#86bd9c",
      "moss": "#4f9a74",
      "sidebar": "#f3f1ea",
      "detail-panel": "#faf9f5"
    },
    "service": {
      "seo": { "base": "#3346d3", "dark": "#2433a6", "soft": "#e3e7fc" },
      "websites": { "base": "#ec6a4c", "dark": "#c9502f", "soft": "#fbe3d9" },
      "mobile-apps": { "base": "#f4b23e", "dark": "#d9921a", "soft": "#fcedc9" },
      "software": { "base": "#1f6f78", "dark": "#15545b", "soft": "#d8ecea" },
      "marketing": { "base": "#d9668f", "dark": "#b23f69", "soft": "#f8dde6" },
      "crm": { "base": "#123b32", "dark": "#0b2620", "soft": "#e0f1e6" },
      "lilac": { "base": "#c7b9f3", "soft": "#ece6fc" }
    },
    "signal": {
      "danger": "#d24b36",
      "info": "#3346d3",
      "notification-dot": "#d9921a",
      "brass-soft": "#fcedc9",
      "brass-text": "#7a5d2c"
    },
    "crm-status": {
      "New": { "bg": "#e0f1e6", "text": "#123b32" },
      "Contacted": { "bg": "#eee8dc", "text": "#474c52" },
      "Proposal": { "bg": "#fcedc9", "text": "#7a5d2c" },
      "Negotiation": { "bg": "#e3e9ef", "text": "#3346d3" },
      "Overdue task": { "bg": "#fbe3d9", "text": "#c9502f" },
      "Email task": { "bg": "#fcedc9", "text": "#7a5200" }
    },
    "crm-kpi-tile": ["#e3e7fc", "#e0f1e6", "#fcedc9", "#fbe3d9"],
    "chart": ["#1f4d3a", "#6f8f72", "#c9a76a", "#c3cfbd"],
    "chart-sparkline": "#16181b"
  },
  "font": {
    "display": { "family": "Mona Sans", "source": "Google Fonts (variable: wdth 75-125, wght 200-900)", "use": "headings, KPI numbers, screen titles" },
    "body": { "family": "Funnel Sans", "source": "Google Fonts (variable: wght 300-800)", "use": "body text and all UI text" },
    "voices": {
      "display": { "family": "Mona Sans", "wdth": 118, "weight": 760, "letterSpacing": "-0.035em", "lineHeight": 0.92 },
      "heading": { "family": "Mona Sans", "wdth": 112, "weight": 700, "letterSpacing": "-0.025em", "lineHeight": 1 },
      "title": { "family": "Mona Sans", "wdth": 106, "weight": 650, "letterSpacing": "-0.015em", "lineHeight": 1.1 },
      "mock-display": { "family": "Mona Sans", "wdth": 112, "weight": 700, "letterSpacing": "-0.03em", "lineHeight": 0.98 },
      "body": { "family": "Funnel Sans", "weight": 400, "lineHeight": 1.35 }
    },
    "numbers": "tabular-nums for every figure"
  },
  "crm-type-scale-px": {
    "24": "KPI values (mock-display)",
    "18": "Screen title, e.g. 'Good morning, Anil' (mock-display)",
    "16": "Large figures in reports",
    "14": "Product name in sidebar (semibold)",
    "12": "Navigation items, card titles",
    "11": "Row text, buttons, workspace name",
    "10": "Secondary text, labels, table cells",
    "9": "Captions, meta, badges, timestamps",
    "8": "Avatar initials, micro labels"
  },
  "crm-layout-px": {
    "frame": { "width": 1240, "height": 590 },
    "sidebar": { "width": 210, "paddingX": 14, "paddingY": 16, "navItem": { "paddingX": 12, "paddingY": 7, "gap": 10, "radius": "pill" } },
    "topbar": { "paddingX": 18, "paddingY": 11, "search": { "maxWidth": 320, "radius": "pill", "background": "#f6f2ea" } },
    "content": { "padding": 16, "gap": 10 },
    "detailPanel": { "width": 320, "padding": 18 },
    "avatar": 22,
    "icon": { "library": "lucide", "strokeWidth": 1.8, "sizes": [12, 13, 14, 16] }
  },
  "radius-px": { "xs": 2, "sm": 4, "md": 6, "lg": 8, "xl": 12, "2xl": 16, "pill": 999, "website-panel": "2rem-2.5rem" },
  "shadow": {
    "panel": "0 1px 2px rgba(22,24,27,0.06), 0 10px 30px -14px rgba(22,24,27,0.22)",
    "scene": "0 2px 4px rgba(22,24,27,0.06), 0 24px 48px -20px rgba(22,24,27,0.3), 0 60px 90px -40px rgba(22,24,27,0.25)",
    "lift": "0 30px 60px -30px rgba(22,24,27,0.45)",
    "app-window": "0 40px 100px -30px rgba(0,0,0,0.7) + 1px ring rgba(0,0,0,0.2)"
  },
  "motion": {
    "pop": "opacity fade, 180ms, ease-out (tab switches, menus)",
    "settle": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "reducedMotion": "all animation off"
  },
  "website-scale": {
    "rootFontSize": "phone <640px: clamp(14px, 100vw/24.375, 18px); tablet 640-1023px: 100vw/48; desktop >=1024px: max(13px, 100vw/90). 1rem = 16px at 390 / 768 / 1440.",
    "container": "max-width 124rem; side padding 1rem / 1.5rem / clamp(2rem, 3vw, 4rem)"
  }
}
