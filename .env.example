DATABASE_URL=postgres://crm:crm@localhost:5432/crm
TEST_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_test
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3001
# Public URL of the app (used for referral links)
APP_URL=http://localhost:5173
# File storage: "local" (./uploads) or "s3" (any S3-compatible bucket, e.g. Cloudflare R2)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for providers that need path-style URLs (e.g. Supabase Storage)
S3_FORCE_PATH_STYLE=false
# First admin, created on startup if missing (only needed once)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
TZ=Asia/Kolkata
