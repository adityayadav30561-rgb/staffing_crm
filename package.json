{
  "name": "staffing-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @crm/web build && pnpm --filter @crm/api build",
    "start": "pnpm --filter @crm/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @crm/api db:migrate",
    "db:generate": "pnpm --filter @crm/api db:generate",
    "db:seed": "pnpm --filter @crm/api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
